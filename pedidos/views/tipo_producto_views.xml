<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="tipo_producto_view_list" model="ir.ui.view">
        <field name="name">tipo.producto.list</field>
        <field name="model">pedidos.tipo.producto</field>
        <field name="arch" type="xml">
            <tree string="Tipo de producto">
                <field name="name" />
            </tree>
        </field>
    </record>
    <record id="tipo_producto_view_form" model="ir.ui.view">
        <field name="name">tipo.producto.form</field>
        <field name="model">pedidos.tipo.producto</field>
        <field name="arch" type="xml">
            <form string="Tipo de producto">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pedidos_tipo_producto_action" model="ir.actions.act_window">
        <field name="name">Tipo de Productos</field>
        <field name="res_model">pedidos.tipo.producto</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>