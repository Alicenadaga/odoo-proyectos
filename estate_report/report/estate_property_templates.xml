<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_property_card">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-field="o.name" />
                        </h2>
                        <p>Precio esperado: <span t-field="o.expected_price" /></p>
                        <p>Estado: <span t-field="o.state" /></p>
                        <p>Vendedor: <span t-field="o.salesperson_id" /></p>
                        <p>Mejor oferta: <span t-field="o.best_price" /></p>
                        <p>Total de ofertas: <span t-field="o.offer_count" /></p>
                        <h4>Ofertas</h4>
                        <t t-if="o.offer_ids">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Precio</th>
                                        <th>Comprador</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.offer_ids" t-as="offer">
                                        <td>
                                            <span t-field="offer.price" />
                                        </td>
                                        <td>
                                            <span t-field="offer.partner_id" />
                                        </td>
                                        <td>
                                            <span t-field="offer.status" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p>Sin ofertas</p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>